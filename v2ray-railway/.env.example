# Country-specific upstream exit nodes.
# One URL or a comma-separated list for failover.
# Supported schemes: socks5://[user:pass@]host:port and http://[user:pass@]host:port
# Keep real credentials only in Railway Variables / sealed variables.
EXIT_NL_URL=
EXIT_DE_URL=
EXIT_GB_URL=
EXIT_US_URL=

# Optional default if a link does not specify a region.
EXIT_DEFAULT_REGION=NL

# Safety: if false, a configured region never falls back to Railway's direct egress.
EXIT_ALLOW_DIRECT_FALLBACK=false

EXIT_CONNECT_TIMEOUT=10
EXIT_HEALTH_TIMEOUT=5
